rules_version = '2';
// JEIGHTEEN: ATELIER and MUSIC are managed separately.
// Like the JonnaRincon site: every account gets users/{uid} automatically, with role 'user'.
// Change role to 'admin' in the Firebase console (Firestore, users) to give someone the dashboard.
service cloud.firestore {
  match /databases/{database}/documents {
    // TESTFASE: true = every signed-in account counts as admin (open for development). Set to false before launch.
    function testfase() {
      return true;
    }
    function isAdmin() {
      return request.auth != null && (testfase() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    // Both brands are managed by the admins for now.
    function canManage(brand) {
      return isAdmin();
    }

    // users/{uid}: own profile (name, e-mail, wishlist, role). A user can never make themselves admin:
    // on create the role must be 'user', on update the role may not change. Admins may read and edit everyone.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && (request.resource.data.role == resource.data.role
                || (!('role' in resource.data) && request.resource.data.role == 'user')));
      allow delete: if isAdmin();
    }

    match /atelier_items/{id} {
      allow read: if resource.data.published == true || canManage('atelier');
      allow write: if canManage('atelier');
    }

    // Settings of the ATELIER page (the film or photo at the top, its texts and link). Public, only atelier admins edit.
    match /atelier_settings/{id} {
      allow read: if true;
      allow write: if canManage('atelier');
    }

    match /music_releases/{id} {
      allow read: if resource.data.published == true || canManage('music');
      allow write: if canManage('music');
    }
  }
}
